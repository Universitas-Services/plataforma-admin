# Copia este archivo como .env.local y completa los valores.

# URL base de plataforma-api (solo la usa el servidor de Next.js / BFF).
API_URL=http://localhost:4000/api/v1

# Secreto para firmar la cookie de sesión (API simulada). En Netlify: una cadena larga aleatoria.
SESION_SECRETO=

# Modo demostración en un despliegue (en desarrollo siempre está activo): muestra los enlaces de
# «Olvidé mi contraseña» en pantalla y la cinta «Entorno de demostración».
DEMO=
